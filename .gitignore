.DS_Store

# Reference screenshots of the old Wix site — kept in history at 38150ba,
# removed from the tip so clones do not pull 45 MB of PNGs.
screenshots of old site/

# Source photography — converted into public/images/ by `npm run images`.
# Keep originals out of git; the optimised WebP output IS committed.
# Leading slash matters: an unanchored `images/` also matches public/images/.
/images/
