# --- Site -------------------------------------------------------------------
# Used for canonical URLs, sitemap and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.betterearthventures.com

# --- Sanity (content) -------------------------------------------------------
# Project is already created. The Studio lives in studio-bev-site/.
# Until these are set the site renders the seed content in src/lib/seed-content.ts.
# Copy this file to .env.local (gitignored) and fill in the token below.
NEXT_PUBLIC_SANITY_PROJECT_ID=utlh4le8
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Editor token with write access. Only needed locally to run `npm run seed`.
# Do NOT add this to the Vercel project.
SANITY_API_WRITE_TOKEN=

# --- Supabase (form submissions) --------------------------------------------
# Newsletter signups and contact enquiries. Until these are set, submissions are
# validated and logged but not persisted.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications (Resend) -------------------------------------------
# Sends the team a copy of every contact-form submission. Until RESEND_API_KEY is
# set, submissions are still stored, just not emailed.
#
# 1. Create a key at https://resend.com/api-keys (free tier: 3,000 emails/month).
# 2. Verify betterearthventures.com at https://resend.com/domains, then set
#    ENQUIRY_NOTIFY_FROM to an address on it. Until the domain is verified,
#    the default onboarding@resend.dev only delivers to the account owner.
RESEND_API_KEY=
# Comma-separated. Defaults to innovate@betterearthventures.com.
ENQUIRY_NOTIFY_TO=
# Must be on a domain verified in Resend.
ENQUIRY_NOTIFY_FROM=Better Earth Ventures <innovate@betterearthventures.com>
# Newsletter signups are not emailed unless this is exactly "true".
NOTIFY_ON_SUBSCRIBE=false

# --- Airtable mirror ---------------------------------------------------------
# Copies each submission into Airtable after it is stored. Non-fatal: if Airtable
# is unreachable the submission is still captured in Supabase.
#
# Token: https://airtable.com/create/tokens — scope it to `data.records:read` and
# `data.records:write` on the BEV CRM base only, plus `schema.bases:read` if you want
# `npm run airtable:check` to be able to compare column names for you.
#
# Read as well as write: a signup is deduplicated by looking the person up on email
# before deciding whether to add them or update what is already there.
AIRTABLE_TOKEN=
# The `app...` segment of the base URL. This is the BEV CRM base.
AIRTABLE_BASE_ID=appYLZb0d4rzdPBbN
# Table ids, not names, so that renaming a table in the Airtable UI does not break the
# forms. Defaults shown; both live in the BEV CRM base.
# Contacts:
AIRTABLE_CONTACTS_TABLE=tbl0XppJlG1f4QPXz
# Enquiries:
AIRTABLE_ENQUIRIES_TABLE=tblgqznGLPaQqXFaW
