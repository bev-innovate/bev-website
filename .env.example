# --- Site -------------------------------------------------------------------
# Used for canonical URLs, sitemap and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.betterearthventures.com

# --- Sanity (content) -------------------------------------------------------
# Create with: npx sanity@latest init
# Until these are set the site renders the seed content in src/lib/seed-content.ts
# and /studio shows setup instructions instead of the editor.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Editor token with write access. Only needed locally to run `npm run seed`.
# Do NOT add this to the Vercel project.
SANITY_API_WRITE_TOKEN=

# --- Supabase (form submissions) --------------------------------------------
# Newsletter signups and contact enquiries. Until these are set, submissions are
# validated and logged but not persisted.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
